# Образец настроек production (deploy/README.md). На сервере: cp .env.production.example .env
# и заполнить. .env в git не попадает. Пароли — без пробелов, кавычек и знака $;
# генерировать так: openssl rand -hex 32

# --- Режим -----------------------------------------------------------------------------------
# Свой сервер: только docker-compose.prod.yml. Сервер мессенджера (HTTPS делает его Caddy):
# COMPOSE_FILE=docker-compose.prod.yml:docker-compose.edge.yml
COMPOSE_FILE=docker-compose.prod.yml

# --- Адрес сайта -----------------------------------------------------------------------------
# Домен: Caddy сам получит сертификат Let's Encrypt (DNS домена должен указывать на сервер,
# порты 80 и 443 — открыты). ":80" — без HTTPS (за внешним прокси с TLS — сервер мессенджера —
# или локальная проверка)
SITE_ADDRESS=csharp.example.org
# Почта для Let's Encrypt: письма об истечении сертификата (при SITE_ADDRESS=:80 не используется,
# но должна быть задана)
ACME_EMAIL=
# Порты на сервере
HTTP_PORT=80
HTTPS_PORT=443
# Внешний прокси перед Caddy (если есть) — его подсеть; иначе не менять.
# Сервер мессенджера: private_ranges (его Caddy — в частной сети Docker edge)
CADDY_TRUSTED_PROXIES=127.0.0.1/32

# --- Образы ----------------------------------------------------------------------------------
# Откуда образы: csharp-school — собраны на этой машине (make prod-build);
# ghcr.io/nikolas-bars/csharp-school — собраны GitHub Actions после мёржа в main (workflow images)
IMAGE_PREFIX=csharp-school
# Тег образов: коммит main (полный SHA) или latest; откат — предыдущий тег
IMAGE_TAG=latest

# --- Laravel ---------------------------------------------------------------------------------
APP_NAME="C# School"
# base64:… — сгенерировать: echo "base64:$(openssl rand -base64 32)". Сменить = выйти всех
APP_KEY=
APP_URL=https://csharp.example.org
# Адрес сайта для ссылок в письмах (сброс пароля); при одном домене — тот же, что APP_URL
FRONTEND_URL=https://csharp.example.org
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

# API на том же домене, что и сайт (/api) — CORS не нужен, пусто. Отдельный домен фронта — его адрес
CORS_ALLOWED_ORIGINS=

# Через сколько минут истекает токен входа; пусто — бессрочно
SANCTUM_TOKEN_EXPIRATION=10080

# Воркеры RoadRunner: по ~60 МБ памяти каждый. 2 — для общего сервера (лимит api — 384 МБ);
# на своём сервере — примерно 2 на ядро и API_MEM_LIMIT побольше
RR_NUM_WORKERS=2

# --- База и Redis (сервисы стека, наружу не открыты) -------------------------------------------
DB_DATABASE=csharp_school
DB_USERNAME=csharp_school
DB_PASSWORD=
REDIS_PASSWORD=

# --- Почта (письма ученикам) -------------------------------------------------------------------
# log — письма только в журнал. Для настоящей отправки: smtp и данные почтового сервиса
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="C# School"

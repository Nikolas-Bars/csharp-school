    {
      "type": "quiz",
      "questions": [
        {
          "question": {
            "ru": "Когда выполняются команды в блоке if (hp > 0) { … }?"
          },
          "options": [
            {
              "ru": "Только когда hp больше нуля"
            },
            {
              "ru": "Всегда, при любом hp"
            },
            {
              "ru": "Только когда hp равно нулю"
            }
          ],
          "answer": 0,
          "explanation": {
            "ru": "Блок if выполняется, только если условие true."
          }
        },
        {
          "question": {
            "ru": "Что делает else?"
          },
          "options": [
            {
              "ru": "Выполняется всегда после if"
            },
            {
              "ru": "Повторяет проверку if ещё раз"
            },
            {
              "ru": "Выполняется, когда условие if ложно"
            }
          ],
          "answer": 2,
          "explanation": {
            "ru": "else — «иначе»: из двух блоков выполнится ровно один."
          }
        },
        {
          "question": {
            "ru": "Нужна ли точка с запятой сразу после if (hp > 0)?"
          },
          "options": [
            {
              "ru": "Да, как после любой команды"
            },
            {
              "ru": "Нет, с ней блок выполнится всегда"
            },
            {
              "ru": "Можно и так, и так — без разницы"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "Точка с запятой обрывает if, и блок после неё выполняется без всякого условия."
          }
        }
      ]
    }
  ]
}

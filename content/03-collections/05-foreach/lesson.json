      "type": "quiz",
      "questions": [
        {
          "question": {
            "ru": "foreach (int x in a) { … } — что лежит в x на каждом шаге?"
          },
          "options": [
            {
              "ru": "Очередной элемент массива"
            },
            {
              "ru": "Индекс этого элемента"
            },
            {
              "ru": "Длина всего массива a"
            }
          ],
          "answer": 0,
          "explanation": {
            "ru": "foreach кладёт в переменную цикла сами элементы по очереди, а не их индексы."
          }
        },
        {
          "question": {
            "ru": "Нужно увеличить каждый элемент массива на 10. Какой цикл подойдёт?"
          },
          "options": [
            {
              "ru": "foreach по элементам"
            },
            {
              "ru": "for по индексам"
            },
            {
              "ru": "Любой из двух"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "Через переменную foreach элемент не изменить — компилятор не разрешит. Менять элементы можно только по индексу: a[i] += 10."
          }
        },
        {
          "question": {
            "ru": "Может ли foreach выйти за границу массива?"
          },
          "options": [
            {
              "ru": "Нет, он сам остановится"
            },
            {
              "ru": "Да, если элементов много"
            },
            {
              "ru": "Да, если забыть Length"
            }
          ],
          "answer": 0,
          "explanation": {
            "ru": "foreach идёт ровно от первого элемента до последнего — индексы он не использует."
          }
        }
      ]
    }
  ]

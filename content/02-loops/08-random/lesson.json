          "question": {
            "ru": "Какие числа может вернуть random.Next(1, 7)?"
          },
          "options": [
            {
              "ru": "От 1 до 7"
            },
            {
              "ru": "От 0 до 6"
            },
            {
              "ru": "От 1 до 6"
            }
          ],
          "answer": 2,
          "explanation": {
            "ru": "Первое число входит в диапазон, второе — нет: 1, 2, 3, 4, 5 или 6."
          }
        },
        {
          "question": {
            "ru": "Зачем в задачах пишут new Random(42), а не new Random()?"
          },
          "options": [
            {
              "ru": "Без числа в скобках Random не работает"
            },
            {
              "ru": "С зерном числа те же при каждом запуске"
            },
            {
              "ru": "Число 42 даёт самые случайные числа"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "Из одного зерна всегда вырастает одна и та же цепочка чисел — поэтому вывод можно проверить."
          }
        },
        {
          "question": {
            "ru": "В цикле на каждой итерации создаётся new Random(42) и вызывается Next. Что получится?"
          },
          "options": [
            {
              "ru": "Каждый раз разные числа"
            },
            {
              "ru": "Программа не скомпилируется"
            },
            {
              "ru": "Каждый раз одно и то же число"
            }
          ],
          "answer": 2,
          "explanation": {
            "ru": "Каждый новый генератор с тем же зерном начинает цепочку сначала и выдаёт её первое число."
          }
        }
      ]

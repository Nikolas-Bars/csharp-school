      "type": "quiz",
      "questions": [
        {
          "question": {
            "ru": "Что напечатает for (int i = 10; i >= 0; i -= 5) { Console.WriteLine(i); }?"
          },
          "options": [
            {
              "ru": "10 и 5"
            },
            {
              "ru": "10, 5 и 0"
            },
            {
              "ru": "0, 5 и 10"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "Счётчик: 10, 5, 0 — для 0 условие 0 >= 0 ещё верно. Следующее значение, -5, уже не подходит."
          }
        },
        {
          "question": {
            "ru": "Какой заголовок подходит для отсчёта от 10 до 1?"
          },
          "options": [
            {
              "ru": "for (int i = 10; i >= 1; i--)"
            },
            {
              "ru": "for (int i = 10; i <= 1; i--)"
            },
            {
              "ru": "for (int i = 10; i >= 1; i++)"
            }
          ],
          "answer": 0,
          "explanation": {
            "ru": "Счётчик уменьшается (i--), пока не меньше 1 (i >= 1). С i <= 1 цикл не выполнится ни разу, а с i++ счётчик пойдёт вверх."
          }
        },
        {
          "question": {
            "ru": "for (int i = 1; i <= 3; i++) { } Console.WriteLine(i); — что будет?"
          },
          "options": [
            {
              "ru": "Напечатается число 3"
            },
            {
              "ru": "Напечатается число 4"
            },
            {
              "ru": "Ошибка: i здесь не видна"
            }
          ],
          "answer": 2,
          "explanation": {
            "ru": "Счётчик, объявленный в скобках for, виден только внутри цикла — это его область видимости."
          }
        }
      ]
    }
  ]

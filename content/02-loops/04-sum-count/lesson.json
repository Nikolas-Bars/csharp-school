      "questions": [
        {
          "question": {
            "ru": "Где объявить переменную для суммы, чтобы вывести её после цикла?"
          },
          "options": [
            {
              "ru": "До цикла, со значением 0"
            },
            {
              "ru": "В теле цикла, со значением 0"
            },
            {
              "ru": "После цикла, перед выводом"
            }
          ],
          "answer": 0,
          "explanation": {
            "ru": "Копилка создаётся до цикла: тогда она не обнуляется на каждой итерации и видна после цикла."
          }
        },
        {
          "question": {
            "ru": "int sum = 0; for (int i = 1; i <= 4; i++) { sum += i; } — чему равно sum после цикла?"
          },
          "options": [
            {
              "ru": "4"
            },
            {
              "ru": "6"
            },
            {
              "ru": "10"
            },
            {
              "ru": "5"
            }
          ],
          "answer": 2,
          "explanation": {
            "ru": "К сумме по очереди прибавляются 1, 2, 3 и 4: 1 + 2 + 3 + 4 = 10."
          }
        },
        {
          "question": {
            "ru": "Что делает count++ внутри if в теле цикла?"
          },
          "options": [
            {
              "ru": "Растёт на каждой итерации цикла"
            },
            {
              "ru": "Считает итерации, где условие верно"
            },
            {
              "ru": "Останавливает цикл, когда условие верно"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "count++ стоит в блоке if, поэтому выполняется только на тех итерациях, где условие верно."
          }
        }
      ]
    }
  ]

      "questions": [
        {
          "question": {
            "ru": "int n = 10; do { n++; } while (n < 5); — сколько раз выполнится тело?"
          },
          "options": [
            {
              "ru": "Ни разу"
            },
            {
              "ru": "Пять раз"
            },
            {
              "ru": "Один раз"
            }
          ],
          "answer": 2,
          "explanation": {
            "ru": "Тело do-while выполняется до первой проверки. Потом 11 < 5 — неверно, и цикл заканчивается."
          }
        },
        {
          "question": {
            "ru": "Чем do-while отличается от while?"
          },
          "options": [
            {
              "ru": "Условие проверяется после тела"
            },
            {
              "ru": "Тело может не выполниться ни разу"
            },
            {
              "ru": "Условие пишется перед словом do"
            }
          ],
          "answer": 0,
          "explanation": {
            "ru": "У do-while условие стоит после тела, поэтому тело выполняется хотя бы раз. Ни разу может не выполниться как раз while."
          }
        },
        {
          "question": {
            "ru": "Почему переменную roll объявляют до do, а не внутри тела?"
          },
          "options": [
            {
              "ru": "Так цикл работает быстрее"
            },
            {
              "ru": "Внутри тела нельзя объявлять переменные"
            },
            {
              "ru": "Иначе её не видно в условии while"
            }
          ],
          "answer": 2,
          "explanation": {
            "ru": "Переменная из тела видна только внутри его фигурных скобок, а условие стоит уже за ними."
          }
        }
      ]
    }
  ]

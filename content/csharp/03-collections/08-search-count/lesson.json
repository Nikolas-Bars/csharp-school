      "questions": [
        {
          "question": {
            "ru": "Почему флаг found в начале равен false?"
          },
          "options": [
            {
              "ru": "Так цикл работает заметно быстрее"
            },
            {
              "ru": "Иначе цикл просто не запустится"
            },
            {
              "ru": "Пока не нашли — считаем, что нет"
            }
          ],
          "answer": 2,
          "explanation": {
            "ru": "До поиска ничего не найдено. Флаг поднимается, только когда элемент встретился."
          }
        },
        {
          "question": {
            "ru": "Где печатать «Ничего не найдено»?"
          },
          "options": [
            {
              "ru": "Внутри цикла, в блоке else"
            },
            {
              "ru": "После цикла, проверив флаг"
            },
            {
              "ru": "До цикла, перед поиском"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "Сказать «нет» можно только после того, как просмотрены все элементы."
          }
        },
        {
          "question": {
            "ru": "int[] a = { 3, 7, 7, 1 }; int count = 0; foreach (int x in a) { if (x == 7) { count++; } } Чему равно count?"
          },
          "options": [
            {
              "ru": "1"
            },
            {
              "ru": "2"
            },
            {
              "ru": "7"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "Семёрка встречается в массиве дважды — счётчик вырастет два раза."
          }
        }
      ]
    }
  ]

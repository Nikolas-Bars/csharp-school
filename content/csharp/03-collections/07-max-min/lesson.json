    {
      "type": "quiz",
      "questions": [
        {
          "question": {
            "ru": "С чего лучше начать поиск максимума в массиве a?"
          },
          "options": [
            {
              "ru": "int best = 0;"
            },
            {
              "ru": "int best = a[0];"
            },
            {
              "ru": "int best = a.Length;"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "Первый элемент — настоящее значение из массива. С нуля поиск ошибётся, если все элементы меньше нуля."
          }
        },
        {
          "question": {
            "ru": "int[] a = { 5, 3, 8 }; int min = 0; foreach (int x in a) { if (x < min) { min = x; } } Чему равно min после цикла?"
          },
          "options": [
            {
              "ru": "3"
            },
            {
              "ru": "0"
            },
            {
              "ru": "5"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "Ни один элемент не меньше 0, поэтому min так и останется нулём — а нуля в массиве нет."
          }
        },
        {
          "question": {
            "ru": "Какое условие обновляет минимум в цикле?"
          },
          "options": [
            {
              "ru": "if (x > min)"
            },
            {
              "ru": "if (x == min)"
            },
            {
              "ru": "if (x < min)"
            }
          ],
          "answer": 2,
          "explanation": {
            "ru": "Минимум меняется, когда встретилось значение меньше текущего."
          }
        }
      ]
    }
  ]

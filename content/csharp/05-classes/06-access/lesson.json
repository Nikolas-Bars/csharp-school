    {
      "type": "quiz",
      "questions": [
        {
          "question": {
            "ru": "Перед полем ничего не написано: int hp;. Какой у него доступ?"
          },
          "options": [
            {
              "ru": "public"
            },
            {
              "ru": "private"
            },
            {
              "ru": "static"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "Без модификатора член класса — private: им пользуются только методы этого класса."
          }
        },
        {
          "question": {
            "ru": "Что значит private у поля или метода?"
          },
          "options": [
            {
              "ru": "Виден только в основном коде"
            },
            {
              "ru": "Его нельзя изменить"
            },
            {
              "ru": "Виден только внутри класса"
            }
          ],
          "answer": 2,
          "explanation": {
            "ru": "private — «личный»: пользоваться им могут только методы этого же класса. Менять private-поле эти методы могут сколько угодно."
          }
        },
        {
          "question": {
            "ru": "Зачем прятать поле hp и менять его через метод TakeDamage?"
          },
          "options": [
            {
              "ru": "Так здоровье меняется по правилам"
            },
            {
              "ru": "Так программа работает быстрее"
            },
            {
              "ru": "Без этого поле не создастся"
            }
          ],
          "answer": 0,
          "explanation": {
            "ru": "Снаружи нельзя записать в hp что попало, например −500. Метод следит за правилами — скажем, чтобы здоровье не ушло ниже нуля."
          }
        }
      ]
    }
  ]
}

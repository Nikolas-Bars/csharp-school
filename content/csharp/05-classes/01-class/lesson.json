          "question": {
            "ru": "Что такое класс?"
          },
          "options": [
            {
              "ru": "Чертёж, по которому создают объекты"
            },
            {
              "ru": "Один конкретный герой в игре"
            },
            {
              "ru": "Команда, которая создаёт героя"
            }
          ],
          "answer": 0,
          "explanation": {
            "ru": "Класс — описание: какие данные и действия будут у объектов. Конкретный герой — это объект, а создаёт его new."
          }
        },
        {
          "question": {
            "ru": "Как создать объект класса Hero?"
          },
          "options": [
            {
              "ru": "Hero hero = Hero();"
            },
            {
              "ru": "Hero hero = new Hero;"
            },
            {
              "ru": "Hero hero = new Hero();"
            }
          ],
          "answer": 2,
          "explanation": {
            "ru": "Объект создаёт new, а после имени класса обязательны круглые скобки."
          }
        },
        {
          "question": {
            "ru": "Где в файле пишут классы?"
          },
          "options": [
            {
              "ru": "Перед первой командой"
            },
            {
              "ru": "После команд основного кода"
            },
            {
              "ru": "В любом месте файла"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "Сначала команды основного кода и методы со static, потом классы. Иначе — ошибка CS8803."
          }
        }
      ]
    }

    {
      "type": "quiz",
      "questions": [
        {
          "question": {
            "ru": "Как вызвать метод ShowInfo у героя hero?"
          },
          "options": [
            {
              "ru": "hero.ShowInfo();"
            },
            {
              "ru": "ShowInfo(hero);"
            },
            {
              "ru": "Hero.ShowInfo();"
            }
          ],
          "answer": 0,
          "explanation": {
            "ru": "Метод объекта вызывают через сам объект и точку. Через имя класса Hero — ошибка CS0120: непонятно, чью карточку показать."
          }
        },
        {
          "question": {
            "ru": "Внутри метода класса Hero написано hp -= 10;. Чьё hp уменьшится?"
          },
          "options": [
            {
              "ru": "У всех героев сразу"
            },
            {
              "ru": "Того, у кого вызван метод"
            },
            {
              "ru": "Ничьё: нужна точка"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "Метод работает с полями объекта, у которого его вызвали: knight.TakeDamage(10) меняет здоровье только рыцаря."
          }
        },
        {
          "question": {
            "ru": "Почему метод, который меняет поля, пишут без static?"
          },
          "options": [
            {
              "ru": "static-метод нельзя вызвать"
            },
            {
              "ru": "static-метод не бывает public"
            },
            {
              "ru": "static-метод не знает объекта"
            }
          ],
          "answer": 2,
          "explanation": {
            "ru": "static-метод принадлежит классу целиком, у него нет «своего» объекта — значит, нет и полей. Вызвать его можно, но через имя класса."
          }
        }
      ]
    }
  ]

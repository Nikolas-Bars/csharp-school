    {
      "type": "quiz",
      "questions": [
        {
          "question": {
            "ru": "Что такое итерация цикла?"
          },
          "options": [
            {
              "ru": "Условие в скобках после while"
            },
            {
              "ru": "Один проход тела цикла"
            },
            {
              "ru": "Переменная, которая считает проходы"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "Итерация — одно выполнение тела цикла. Цикл из трёх волн делает три итерации."
          }
        },
        {
          "question": {
            "ru": "int n = 5; while (n < 3) { Console.WriteLine(n); n++; } — сколько раз напечатается n?"
          },
          "options": [
            {
              "ru": "Пять раз"
            },
            {
              "ru": "Три раза"
            },
            {
              "ru": "Ни разу"
            }
          ],
          "answer": 2,
          "explanation": {
            "ru": "Условие проверяется перед первой итерацией: 5 < 3 — неверно, поэтому тело не выполнится ни разу."
          }
        },
        {
          "question": {
            "ru": "int hp = 10; while (hp > 0) { Console.WriteLine(hp); } — почему этот цикл никогда не закончится?"
          },
          "options": [
            {
              "ru": "hp не меняется, условие всегда верно"
            },
            {
              "ru": "В while нельзя печатать числа"
            },
            {
              "ru": "Условие hp > 0 записано с ошибкой"
            }
          ],
          "answer": 0,
          "explanation": {
            "ru": "В теле цикла hp не меняется, поэтому hp > 0 верно всегда. Это бесконечный цикл."
          }
        }
      ]
    }
  ]

      "questions": [
        {
          "question": {
            "ru": "Что делает часть i++ в цикле for (int i = 1; i <= 5; i++)?"
          },
          "options": [
            {
              "ru": "Задаёт начальное значение i"
            },
            {
              "ru": "Проверяет, продолжать ли цикл"
            },
            {
              "ru": "Меняет i после каждой итерации"
            }
          ],
          "answer": 2,
          "explanation": {
            "ru": "Третья часть — шаг: она выполняется после каждой итерации. Начало — первая часть, условие — вторая."
          }
        },
        {
          "question": {
            "ru": "Сколько раз выполнится тело цикла for (int i = 0; i < 4; i++)?"
          },
          "options": [
            {
              "ru": "4"
            },
            {
              "ru": "5"
            },
            {
              "ru": "3"
            }
          ],
          "answer": 0,
          "explanation": {
            "ru": "i пробегает 0, 1, 2, 3 — четыре значения. При i = 4 условие i < 4 уже неверно."
          }
        },
        {
          "question": {
            "ru": "Какой цикл удобнее, если повторять нужно, пока враг жив, а сколько раз — заранее неизвестно?"
          },
          "options": [
            {
              "ru": "for: он подходит всегда"
            },
            {
              "ru": "while: пока условие верно"
            },
            {
              "ru": "Никакой: тут хватит if"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "while повторяет, пока условие верно, — число итераций знать не нужно. for удобнее, когда оно известно заранее."
          }
        }
      ]
    }
  ]

    {
      "type": "quiz",
      "questions": [
        {
          "question": {
            "ru": "Что платформа сделает с программой, в которой бесконечный цикл?"
          },
          "options": [
            {
              "ru": "Будет ждать, пока цикл закончится"
            },
            {
              "ru": "Остановит её через несколько секунд"
            },
            {
              "ru": "Не даст её скомпилировать"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "Компилятор такой код пропускает: ошибки в записи нет. Платформа следит за временем и останавливает зависшую программу."
          }
        },
        {
          "question": {
            "ru": "Как выйти из цикла while (true)?"
          },
          "options": [
            {
              "ru": "Командой continue"
            },
            {
              "ru": "Никак: он вечный"
            },
            {
              "ru": "Командой break"
            }
          ],
          "answer": 2,
          "explanation": {
            "ru": "Условие true верно всегда, поэтому закончить такой цикл может только break. continue лишь начинает следующую итерацию."
          }
        },
        {
          "question": {
            "ru": "Какой из циклов никогда не закончится?"
          },
          "options": [
            {
              "ru": "int i = 0; while (i < 5) { i++; }"
            },
            {
              "ru": "int i = 0; while (i != 5) { i += 2; }"
            },
            {
              "ru": "int i = 5; while (i > 0) { i--; }"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "i принимает только чётные значения: 0, 2, 4, 6… — и никогда не станет равным 5. С условием != легко проскочить нужное число."
          }
        }
      ]
    }
  ]
}

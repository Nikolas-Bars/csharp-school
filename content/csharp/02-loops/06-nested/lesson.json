      "questions": [
        {
          "question": {
            "ru": "Сколько звёздочек напечатает: for (int a = 1; a <= 3; a++) { for (int b = 1; b <= 4; b++) { Console.Write(\"*\"); } }?"
          },
          "options": [
            {
              "ru": "7"
            },
            {
              "ru": "12"
            },
            {
              "ru": "4"
            },
            {
              "ru": "3"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "Внутренний цикл печатает 4 звёздочки и повторяется 3 раза: 3 × 4 = 12."
          }
        },
        {
          "question": {
            "ru": "Чем Console.Write отличается от Console.WriteLine?"
          },
          "options": [
            {
              "ru": "Не переходит на новую строку"
            },
            {
              "ru": "Печатает только числа, без текста"
            },
            {
              "ru": "Печатает текст сразу два раза"
            }
          ],
          "answer": 0,
          "explanation": {
            "ru": "Write печатает и остаётся на той же строке, WriteLine после текста переходит на новую."
          }
        },
        {
          "question": {
            "ru": "Зачем после внутреннего цикла пишут Console.WriteLine()?"
          },
          "options": [
            {
              "ru": "Чтобы закончить всю программу"
            },
            {
              "ru": "Чтобы перейти на новую строку"
            },
            {
              "ru": "Чтобы повторить внутренний цикл"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "WriteLine() с пустыми скобками только переводит строку: следующий ряд начнётся с новой строки."
          }
        }
      ]
    }
  ]

      "questions": [
        {
          "question": {
            "ru": "Что делает знак = в строке int hp = 100;?"
          },
          "options": [
            {
              "ru": "Проверяет, равно ли hp ста"
            },
            {
              "ru": "Кладёт 100 в переменную hp"
            },
            {
              "ru": "Печатает число 100 на экран"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "Знак = — это присваивание: значение справа кладут в переменную слева."
          }
        },
        {
          "question": {
            "ru": "Что напечатает программа: int coins = 5; Console.WriteLine(\"coins\");"
          },
          "options": [
            {
              "ru": "5"
            },
            {
              "ru": "Ошибку"
            },
            {
              "ru": "coins"
            }
          ],
          "answer": 2,
          "explanation": {
            "ru": "В кавычках — строка, поэтому напечатаются буквы coins. Чтобы увидеть значение, имя пишут без кавычек."
          }
        },
        {
          "question": {
            "ru": "Можно ли написать int hp = 100; а ниже ещё раз int hp = 50;?"
          },
          "options": [
            {
              "ru": "Да, значение просто поменяется на 50"
            },
            {
              "ru": "Нет, будет ошибка: hp уже объявлена"
            },
            {
              "ru": "Да, получатся две переменные hp"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "Объявляют переменную один раз, дальше пишут просто hp = 50;"
          }
        }
      ]
    }
  ]

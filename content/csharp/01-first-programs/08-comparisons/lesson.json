          "options": [
            {
              "ru": "False"
            },
            {
              "ru": "True"
            },
            {
              "ru": "5"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "5 равно 5, а >= — «больше или равно». Значит, верно."
          }

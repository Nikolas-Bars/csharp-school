      "type": "quiz",
      "questions": [
        {
          "question": {
            "ru": "hp = 90. Что напечатает программа: if (hp > 30) — «Ранен», else if (hp > 70) — «Полон сил», else — «Еле жив»?"
          },
          "options": [
            {
              "ru": "Полон сил"
            },
            {
              "ru": "Ранен и Полон сил"
            },
            {
              "ru": "Ранен"
            }
          ],
          "answer": 2,
          "explanation": {
            "ru": "Срабатывает первое верное условие: 90 > 30, дальше программа не смотрит."
          }
        },
        {
          "question": {
            "ru": "Сколько блоков из цепочки if / else if / else выполнится за раз?"
          },
          "options": [
            {
              "ru": "Один — первый с верным условием"
            },
            {
              "ru": "Все, у которых условие верно"
            },
            {
              "ru": "Всегда только последний"
            }
          ],
          "answer": 0,
          "explanation": {
            "ru": "Выполняется только первый блок с верным условием, а если таких нет — else."
          }
        },
        {
          "question": {
            "ru": "Обязательно ли писать else в конце?"
          },
          "options": [
            {
              "ru": "Да, иначе будет ошибка"
            },
            {
              "ru": "Нет, он нужен не всегда"
            },
            {
              "ru": "Да, без else не работает else if"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "Без else при всех ложных условиях просто ничего не выполнится. else пишут, когда и для «всех остальных случаев» нужно действие."
          }
        }
      ]
    }
  ]
}

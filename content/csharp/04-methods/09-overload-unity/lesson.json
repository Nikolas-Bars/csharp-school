      "type": "quiz",
      "questions": [
        {
          "question": {
            "ru": "Какие числа может выдать Random.Range(1, 7) в Unity?"
          },
          "options": [
            {
              "ru": "От 1 до 7"
            },
            {
              "ru": "От 0 до 6"
            },
            {
              "ru": "От 1 до 6"
            }
          ],
          "answer": 2,
          "explanation": {
            "ru": "У целых чисел верхняя граница не входит — как у random.Next(1, 7). Выпадет 1, 2, 3, 4, 5 или 6."
          }
        },
        {
          "question": {
            "ru": "Можно ли в нашей программе объявить два своих метода Add с разными параметрами?"
          },
          "options": [
            {
              "ru": "Да, это и есть перегрузка"
            },
            {
              "ru": "Нет, имена должны различаться"
            },
            {
              "ru": "Да, если тип возврата разный"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "Перегрузка — методы с одним именем и разными параметрами, но методы в нашем файле — локальные функции, а их имена не могут повторяться. В классах перегружать можно, но только по параметрам: тип возврата в сигнатуру не входит, поэтому методы, которые отличаются только им, не различить даже там."
          }
        },
        {
          "question": {
            "ru": "Кто и когда вызывает методы Start и Update в Unity?"
          },
          "options": [
            {
              "ru": "Сам Unity, в нужный момент"
            },
            {
              "ru": "Твой код, обычным вызовом"
            },
            {
              "ru": "Основной код, по одному разу"
            }
          ],
          "answer": 0,
          "explanation": {
            "ru": "Start и Update вызывает сам Unity: Start — один раз перед первым кадром, когда скрипт включён, Update — перед каждым кадром."
          }
        },
        {
          "question": {
            "ru": "Как в Unity напечатать сообщение в окно Console?"
          },
          "options": [
            {
              "ru": "Console.WriteLine(\"Привет\");"
            },
            {
              "ru": "Print.Line(\"Привет\");"
            },
            {
              "ru": "Debug.Log(\"Привет\");"
            }
          ],
          "answer": 2,
          "explanation": {
            "ru": "В Unity печатают через Debug.Log. Console.WriteLine там в окне Console не появится."
          }
        }
      ]
    }

            {
              "ru": "true"
            },
            {
              "ru": "0"
            },
            {
              "ru": "false"
            }
          ],
          "answer": 2,
          "explanation": {
            "ru": "0 > 0 — неверно, поэтому метод вернёт false."
          }
        },

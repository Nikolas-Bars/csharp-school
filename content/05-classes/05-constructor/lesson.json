    {
      "type": "quiz",
      "questions": [
        {
          "question": {
            "ru": "Как называется конструктор класса Enemy?"
          },
          "options": [
            {
              "ru": "Create"
            },
            {
              "ru": "Enemy"
            },
            {
              "ru": "New"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "Имя конструктора всегда совпадает с именем класса. Вызывается он через new Enemy(…)."
          }
        },
        {
          "question": {
            "ru": "Что пишут перед именем конструктора как тип ответа?"
          },
          "options": [
            {
              "ru": "Ничего не пишут"
            },
            {
              "ru": "Слово void"
            },
            {
              "ru": "Тип класса Enemy"
            }
          ],
          "answer": 0,
          "explanation": {
            "ru": "У конструктора нет типа ответа. С void получится обычный метод с именем класса — ошибка CS0542."
          }
        },
        {
          "question": {
            "ru": "В конструкторе Hero(int hp) написано hp = hp;. Что будет с полем hp?"
          },
          "options": [
            {
              "ru": "Станет равно параметру"
            },
            {
              "ru": "Останется равно 0"
            },
            {
              "ru": "Будет ошибка компилятора"
            }
          ],
          "answer": 1,
          "explanation": {
            "ru": "Оба hp здесь — параметр: он кладётся сам в себя, а поле не меняется и остаётся 0. Программа запустится, компилятор только выдаст предупреждение — подсказку о подозрительном месте. Нужно this.hp = hp;"
          }
        },
        {
          "question": {
            "ru": "Что значит this внутри метода объекта?"
          },
          "options": [
            {
              "ru": "Первый созданный объект"
            },
            {
              "ru": "Класс, где написан метод"
            },
            {
              "ru": "Объект, у которого вызван метод"
            }
          ],
          "answer": 2,
          "explanation": {
            "ru": "this — сам объект, с которым сейчас работает метод или конструктор. this.hp — поле именно этого объекта."
          }
        }
      ]
    }
  ]

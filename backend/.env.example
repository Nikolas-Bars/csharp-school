APP_NAME="C# School"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8290

# Порты на хосте (читает docker compose). Не пересекаются с artverse (8190, 33170, 6490)
APP_PORT=8290
DB_FORWARD_PORT=33270
REDIS_FORWARD_PORT=6590

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=csharp_school
DB_USERNAME=user
DB_PASSWORD=user

SESSION_DRIVER=array
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Письма (сброс пароля). log — письмо пишется в лог (make logs), для разработки
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Адрес фронта: на него ведут ссылки из писем
FRONTEND_URL=http://localhost:5390

# Через сколько минут истекает токен входа; пусто — бессрочно
SANCTUM_TOKEN_EXPIRATION=10080

# Откуда фронтенду разрешено ходить в API (через запятую)
CORS_ALLOWED_ORIGINS=http://localhost:5390

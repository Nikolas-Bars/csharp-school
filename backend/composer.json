{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "csharp-school/api",
    "type": "project",
    "description": "API обучающей платформы C# School: аккаунты, курс, прогресс. Код учеников сервер не выполняет.",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "roadrunner-php/laravel-bridge": "^6.0",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-route-attributes": "^1.20",
        "spiral/roadrunner-http": "^3.5"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.64",
        "larastan/larastan": "^3.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5.50",
        "zircote/swagger-php": "^6.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "lint": "php-cs-fixer fix",
        "lint-check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": [
            "phpstan clear-result-cache -q",
            "phpstan analyse --memory-limit=1G"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "phpunit"
        ],
        "openapi": "openapi app --exclude Tests --output openapi.json",
        "check": [
            "@lint-check",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.20"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

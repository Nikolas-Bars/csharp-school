includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - tests/PHPStanRules/services.neon

parameters:
    level: 10
    tmpDir: .phpstan-cache
    paths:
        - app
        - bootstrap/app.php
        - database
        - routes
    excludePaths:
        - app/Modules/*/Tests/*
    checkMissingCallableSignature: true
    checkUninitializedProperties: true
    ignoreErrors:
        # Ложное срабатывание strict-rules с Larastan: orderBy, whereIn… Eloquent Builder пробрасывает
        # в Query Builder через __call, и правило принимает их за статические
        -
            identifier: staticMethod.dynamicCall
            message: '#^Dynamic call to static method Illuminate\\Database\\Eloquent\\Builder<#'

# Правила проекта — ARCHITECTURE.md; у каждого есть тест в tests/PHPStanRules
rules:
    - Tests\PHPStanRules\ModuleStructureRule
    - Tests\PHPStanRules\ModuleBoundaryRule
    - Tests\PHPStanRules\ControllerRule
    - Tests\PHPStanRules\LayerDependencyRule
    - Tests\PHPStanRules\DbAccessRule
    - Tests\PHPStanRules\QueryInLoopRule
    - Tests\PHPStanRules\InArrayInLoopRule
    - Tests\PHPStanRules\NoCodeExecutionRule
    - Tests\PHPStanRules\NoDebugFunctionsRule
    - Tests\PHPStanRules\VariableCamelCaseRule

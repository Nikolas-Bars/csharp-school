# syntax=docker/dockerfile:1.7
#
# Production-образ API (deploy/README.md). Отличия от Dockerfile_local:
# - зависимости без dev (composer install --no-dev), автозагрузка — classmap;
# - в образе только код приложения: без тестов, линтеров, Makefile и документации;
# - учебный контент (../content) лежит внутри образа в /var/www/content — без решений и неверных
#   решений: course:import они не нужны (их проверяют тесты runner);
# - OPcache включён, процесс работает от www-data, кэши конфигурации и маршрутов — при старте
#   (в них попадают переменные окружения, которых при сборке нет).
#
# Сборка из корня репозитория (контент — отдельный контекст):
#   docker build -f backend/.docker/Dockerfile_prod --build-context content=content backend

FROM ghcr.io/roadrunner-server/roadrunner:2025.1.11 AS roadrunner
FROM composer:2 AS composer

# Общая основа сборки и запуска: PHP + расширения, которых требуют composer.lock и RoadRunner
FROM php:8.3-cli-alpine AS base

# redis — не через pecl install: версия закреплена, архив с проверкой SHA-256 и запасным
# источником, если pecl.php.net недоступен (php/ext-source.sh). Скрипт в образ не попадает
RUN --mount=type=bind,source=.docker/php/ext-source.sh,target=/tmp/ext-source.sh \
    apk add --no-cache icu-libs \
    && apk add --no-cache --virtual .build-deps $PHPIZE_DEPS icu-dev linux-headers \
    && docker-php-source extract \
    && sh /tmp/ext-source.sh redis \
    && docker-php-ext-install -j"$(nproc)" bcmath intl pcntl pdo_mysql redis sockets \
    && docker-php-source delete \
    && apk del .build-deps

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
COPY .docker/php/php.prod.ini $PHP_INI_DIR/conf.d/zz-prod.ini
COPY --from=roadrunner /usr/bin/rr /usr/local/bin/rr

WORKDIR /var/www/html

# Сборка: зависимости, автозагрузка, очистка от всего, что не нужно для работы
FROM base AS build

COPY --from=composer /usr/bin/composer /usr/local/bin/composer
ENV COMPOSER_HOME=/tmp/composer COMPOSER_CACHE_DIR=/tmp/composer-cache

COPY composer.json composer.lock ./
RUN --mount=type=cache,target=/tmp/composer-cache \
    composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction --no-progress

COPY . .
# Скрипты composer (package:discover) пишут в bootstrap/cache список пакетов — он одинаков для
# всех окружений и попадает в образ. check-platform-reqs — сборка падает, если не хватает расширения
RUN composer dump-autoload --no-dev --classmap-authoritative --no-interaction \
    && composer check-platform-reqs --no-dev --no-interaction \
    && rm -rf .docker tests .dockerignore .editorconfig .env.example .gitattributes .gitignore \
        .php-cs-fixer.php phpstan.neon phpunit.xml .phpunit.result.cache \
        Makefile docker-compose.yml README.md CLAUDE.md ARCHITECTURE.md \
        storage/logs/* storage/framework/cache/data/* storage/framework/views/* \
    && find app/Modules -mindepth 2 -maxdepth 2 -type d -name Tests -exec rm -rf {} +

COPY --from=content . /var/www/content
RUN find /var/www/content \( -name 'solution.cs' -o -name 'wrong-*.cs' -o -name 'README.md' \) -delete

# Запуск
FROM base AS production

# Метки: GHCR связывает образ с репозиторием, deploy.sh по title чистит старые образы
LABEL org.opencontainers.image.title="csharp-school" \
      org.opencontainers.image.source="https://github.com/Nikolas-Bars/csharp-school" \
      org.opencontainers.image.licenses="MIT"

ENV APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    COURSE_CONTENT_PATH=/var/www/content

# Код принадлежит root и только читается; писать www-data может лишь в storage и bootstrap/cache
COPY --from=build /var/www/html /var/www/html
COPY --from=build /var/www/content /var/www/content
# Папку /var/www/html базовый образ php делает общей на запись (1777) — возвращаем обычные права
RUN chown root:root /var/www/html \
    && chmod 0755 /var/www/html \
    && chown -R www-data:www-data storage bootstrap/cache

COPY .docker/roadrunner/.rr.prod.yaml /etc/roadrunner/rr.yaml
COPY --chmod=0755 .docker/prod/entrypoint.sh /usr/local/bin/app-entrypoint

USER www-data
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=6 \
    CMD wget -qO /dev/null http://127.0.0.1:8080/up || exit 1

ENTRYPOINT ["app-entrypoint"]
CMD ["rr", "serve", "-c", "/etc/roadrunner/rr.yaml", "-w", "/var/www/html"]
